# TalkAboutThis - Variables de entorno (plantilla)
#
# Copia este archivo a `.env` (ignorado por git) y rellena los valores.
# NUNCA subas un archivo .env real al repositorio (RNF-04).

# --- Seleccion de proveedor de LLM (RF-02) ---
# Valores admitidos: ollama | openai | anthropic | gemini
LLM_PROVIDER=ollama

# --- Motor local: Ollama / LM Studio (RF-02) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- APIs SaaS: solo define la que uses ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- GitHub Projects v2 (RF-05) ---
# El PAT requiere scope 'project' (classic) o project permissions (fine-grained).
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_PROJECT_ID=

# --- Comportamiento ---
# El flag de linea de comandos gana al valor de aqui. Si no pasas --log-level,
# --log-format, --provider ni --timeout, entonces mandan estas variables.
LOG_LEVEL=info
LOG_FORMAT=text
REQUEST_TIMEOUT=60s

# --- Politica ante responsables no mapeados (TC-04) ---
# fail              error si alguien no aparece en la tabla (por defecto)
# assign_unassigned publica la tarjeta sin responsable
# skip              descarta el item y continua
ASSIGNEE_POLICY=fail
